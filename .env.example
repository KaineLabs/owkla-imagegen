# Copy to `.env` and fill in real values. Never commit `.env`.

# Supabase — the same values the main Owkla app uses.
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# FLUX server. Defaults to http://127.0.0.1:7860 if unset.
# Point at your remote FLUX box (Vast AI instance, etc.) when needed.
# FLUX_URL=http://<host>:7860
